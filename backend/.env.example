# Copy to backend/.env (never commit real secrets)
# Express also loads repo-root `.env` first for DATABASE_URL / NEXT_PUBLIC_API_URL,
# then overrides with this file (JWT, MAILER_*, PORT, …).

PORT=8080
API_PORT=8080
BASE_URL=http://localhost:8080

# Comma-separated extra CORS origins (optional).
# Primary storefront origin comes from root NEXT_PUBLIC_API_URL.
# CORS_ORIGINS=http://localhost:3001,https://staging.example.com

JWT_TOKEN=your-secret

# Required for Express auth emails (@repo/mailer). Separate from root MAILER_*.
MAILER_ADDRESS=you@example.com
MAILER_SECRET=your-app-password

EMAIL_CONFIRMATION_COUPON_CODE=
SUPPORT_EMAIL=support@example.com
