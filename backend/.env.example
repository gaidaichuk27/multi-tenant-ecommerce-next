# Copy to backend/.env (never commit real secrets)

PORT=8080
API_PORT=8080
BASE_URL=http://localhost:8080
STOREFRONT_URL=http://localhost:3000

# Comma-separated extra CORS origins (optional)
# CORS_ORIGINS=http://localhost:3001,https://staging.example.com

# Auth / mailer (add when implementing those features)
JWT_TOKEN=your-secret
MAILER_ADDRESS=you@example.com
MAILER_SECRET=your-app-password
DEFAULT_LOCALE=en
EMAIL_CONFIRMATION_COUPON_CODE=
SUPPORT_EMAIL=support@example.com
