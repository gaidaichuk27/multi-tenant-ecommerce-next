{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./*"],
            "@features/*": ["./src/features/*"],
            "@helpers/*": ["./src/helpers/*"],
            "@hooks/*": ["./src/hooks/*"],
            "@hocs/*": ["./src/hocs/*"],
            "@icons/*": ["./src/shared/assets/icons/*"],
            "@images/*": ["./src/shared/assets/images/*"],
            "@layouts/*": ["./src/layouts/*"],
            "@lib/*": ["./src/lib/*"],
            "@locales/*": ["./src/locales/*"],
            "@providers/*": ["./src/providers/*"],
            "@shared/*": ["./src/shared/*"],
            "@services/*": ["./src/services/*"],
            "@styles/*": ["./src/styles/*"],
            "@TRPC/*": ["./src/TRPC/*"],
            "@widgets/*": ["./src/widgets/*"],
            "@views/*": ["./src/views/*"]
        }
    },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
    "exclude": ["node_modules", "backend", "packages"]
}
