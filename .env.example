# Copy to repo root as `.env` (never commit real secrets)

NEXT_PUBLIC_API_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/multi-tenant

# Required for Next/tRPC membership emails (@repo/mailer).
# Do not rely on these for Express — set MAILER_* in backend/.env instead.
MAILER_ADDRESS=you@example.com
MAILER_SECRET=your-app-password

# Optional Docker overrides (see .env.docker.example)
# DOCKER_USE_BUNDLED_POSTGRES=1
