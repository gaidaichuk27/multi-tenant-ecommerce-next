#!/usr/bin/env sh
set -e

cd "$(dirname "$0")/.."

COMPOSE="docker compose"

usage() {
    cat <<'EOF'
Usage:
  multi dev up              Install deps, db:generate, start Docker dev (uses host Postgres :5432)
  multi dev down            Stop Docker dev stack
  multi dev down force      Kill containers immediately, then remove them
  multi story up            Start Storybook (port 6006)
  multi story down          Stop Storybook
  multi up                  Start dev + Storybook
  multi down                Stop dev + Storybook
  multi refresh             Recreate node_modules volumes and restart dev + Storybook
  multi prod up             Start production app (port 3000)
  multi prod down           Stop production app

If `multi` is not found:
  • Cursor terminal: reopen terminal (uses .vscode/settings.json)
  • Any shell with direnv: direnv allow  (uses .envrc)
  • Otherwise: source scripts/shell-env.sh
  • Fallback: pnpm run multi dev up
EOF
    exit 1
}

profile="${1:-}"
action="${2:-}"
extra="${3:-}"

if [ -z "$profile" ]; then
    usage
fi

# "multi up" / "multi down" / "multi refresh" → all dev services
if [ "$profile" = "up" ] || [ "$profile" = "down" ] || [ "$profile" = "refresh" ]; then
    action="$profile"
    profile="all"
fi

case "$action" in
    up|down|refresh) ;;
    *) usage ;;
esac

run() {
    # shellcheck disable=SC2086
    $COMPOSE "$@"
}

# docker-compose.yml references ${DOCKER_DATABASE_URL}; load it for up/down/logs.
load_compose_env() {
    # shellcheck disable=SC1091
    . scripts/docker-env.sh
    load_root_env
    derive_docker_db_env
    export DOCKER_DATABASE_URL
    if [ "${DOCKER_USE_BUNDLED_POSTGRES:-}" = "1" ]; then
        export DOCKER_POSTGRES_USER DOCKER_POSTGRES_PASSWORD
    fi
}

case "${profile}-${action}" in
    dev-up)
        sh scripts/docker-dev-up.sh
        ;;
    dev-down)
        load_compose_env
        if [ "$extra" = "force" ] || [ "$extra" = "--force" ]; then
            run --profile dev kill 2>/dev/null || true
            run --profile dev-db kill 2>/dev/null || true
            run --profile dev --profile dev-db down --remove-orphans --timeout 0
        else
            run --profile dev --profile dev-db down --remove-orphans
        fi
        ;;
    story-up)
        run --profile storybook up --build storybook
        ;;
    story-down)
        run --profile storybook down
        ;;
    all-up)
        run --profile dev --profile storybook up --build
        ;;
    all-down)
        load_compose_env
        run --profile dev --profile storybook down
        ;;
    all-refresh)
        load_compose_env
        run --profile dev --profile storybook down -v
        run --profile dev --profile storybook up --build
        ;;
    prod-up)
        run --profile prod up --build app
        ;;
    prod-down)
        run --profile prod down
        ;;
    *)
        usage
        ;;
esac
