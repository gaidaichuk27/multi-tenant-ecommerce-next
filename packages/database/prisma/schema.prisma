generator client {
    provider      = "prisma-client-js"
    output        = "../src/generated/client"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum PlatformRole {
    user
    super_admin
}

enum GroupVisibility {
    public
    private
    hidden
}

enum GroupMembershipRole {
    owner
    admin
    moderator
    member
}

enum GroupMembershipStatus {
    active
    pending
    banned
}

enum PostType {
    text
}

enum PostReportStatus {
    open
    resolved
    dismissed
}

model User {
    id                      String         @id @default(cuid())
    email                   String         @unique @db.VarChar(255)
    username                String         @unique @db.VarChar(100) // TODO: keep unique as handle; allow duplicate display names via `name`
    name                    String?        @db.VarChar(255)
    avatarUrl               String?        @map("avatar_url") @db.VarChar(500)
    passwordHash            String         @map("password_hash") @db.VarChar(255)
    isEmailConfirmed        Boolean        @default(false) @map("is_email_confirmed")
    /** Bumped on password change/restore to invalidate existing access JWTs. */
    tokenVersion            Int            @default(0) @map("token_version")
    roles                   PlatformRole[] @default([user])
    /** SHA-256 of the active password-reset JWT (single-use). */
    resetPasswordToken      String?        @map("reset_password_token") @db.VarChar(255)
    resetPasswordExpiration DateTime?      @map("reset_password_expiration") @db.Timestamp(6)
    loginAttempts           Int            @default(0) @map("login_attempts")
    lockUntil               DateTime?      @map("lock_until") @db.Timestamp(6)
    createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)

    ownedGroups       Group[]            @relation("GroupOwner")
    groupMemberships  GroupMembership[]
    posts             Post[]
    comments          Comment[]
    postLikes         PostLike[]
    postReports       PostReport[]       @relation("PostReportReporter")
    resolvedReports   PostReport[]       @relation("PostReportResolver")

    @@map("users")
}

model Group {
    id          String          @id @default(cuid())
    slug        String          @unique @db.VarChar(100)
    name        String          @db.VarChar(255)
    description String?         @db.Text
    logoUrl     String?         @map("logo_url") @db.VarChar(500)
    coverUrl    String?         @map("cover_url") @db.VarChar(500)
    ownerId     String          @map("owner_id")
    visibility  GroupVisibility @default(public)
    createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamp(6)

    owner       User              @relation("GroupOwner", fields: [ownerId], references: [id])
    settings    GroupSettings?
    memberships GroupMembership[]
    posts       Post[]
    postReports PostReport[]
    categories  Category[]

    @@map("groups")
}

model GroupSettings {
    groupId        String   @id @map("group_id")
    welcomeMessage String?  @map("welcome_message") @db.Text
    rules          String?  @db.Text
    tabsConfigJson Json?    @map("tabs_config_json")
    pluginsJson    Json?    @map("plugins_json")
    createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@map("group_settings")
}

model GroupMembership {
    id        String                @id @default(cuid())
    groupId   String                @map("group_id")
    userId    String                @map("user_id")
    role      GroupMembershipRole   @default(member)
    status    GroupMembershipStatus @default(active)
    points    Int                   @default(0)
    level     Int                   @default(1)
    joinedAt  DateTime              @default(now()) @map("joined_at") @db.Timestamp(6)
    createdAt DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([groupId, userId])
    @@map("group_memberships")
}

/**
 * Feed categories for a group (max 10 enforced in category.create).
 * `permissions` is schema-ready for later ACL; v1 always uses all_members.
 * Ordering is manual via `sortOrder` (category.reorder); no sortMode matrix yet.
 * Uniqueness is case-insensitive via `nameNormalized` (lower(name)).
 */
model Category {
    id             String   @id @default(cuid())
    groupId        String   @map("group_id")
    name           String   @db.VarChar(100)
    /** lower(name) — enforces case-insensitive uniqueness per group. */
    nameNormalized String   @map("name_normalized") @db.VarChar(100)
    sortOrder      Int      @default(0) @map("sort_order")
    /** Reserved: who may post here. v1 = all_members only (no ACL checks yet). */
    permissions    String   @default("all_members") @db.VarChar(50)
    createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

    group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
    posts Post[]

    @@unique([groupId, nameNormalized])
    @@index([groupId, sortOrder])
    @@map("categories")
}

model Post {
    id             String   @id @default(cuid())
    groupId        String   @map("group_id")
    authorId       String   @map("author_id")
    categoryId     String?  @map("category_id")
    body           String   @db.Text
    type           PostType @default(text)
    pinned         Boolean  @default(false)
    broadcastEmail Boolean  @default(false) @map("broadcast_email")
    createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

    group    Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
    author   User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
    category Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    comments Comment[]
    likes    PostLike[]
    reports  PostReport[]

    @@index([groupId, createdAt(sort: Desc)])
    @@index([groupId, categoryId])
    @@index([authorId])
    @@map("posts")
}

model PostLike {
    id        String   @id @default(cuid())
    postId    String   @map("post_id")
    userId    String   @map("user_id")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

    post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([postId, userId])
    @@index([postId])
    @@index([userId])
    @@map("post_likes")
}

model Comment {
    id        String   @id @default(cuid())
    postId    String   @map("post_id")
    parentId  String?  @map("parent_id")
    authorId  String   @map("author_id")
    body      String   @db.Text
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

    post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
    parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
    replies Comment[] @relation("CommentThread")
    author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

    @@index([postId, createdAt])
    @@index([parentId])
    @@index([authorId])
    @@map("comments")
}

/**
 * Member report against a post in a group.
 * Partial unique index (post_id, reporter_id) WHERE status = 'open' is applied in
 * the migration SQL so a user can re-report after resolve/dismiss, but not while open.
 */
model PostReport {
    id          String           @id @default(cuid())
    postId      String           @map("post_id")
    groupId     String           @map("group_id")
    reporterId  String           @map("reporter_id")
    /** Optional free-text reason from the reporter (max 500 at API). */
    reason      String?          @db.Text
    status      PostReportStatus @default(open)
    resolverId  String?          @map("resolver_id")
    /** Optional admin note when resolving/dismissing. */
    resolveNote String?          @map("resolve_note") @db.Text
    resolvedAt  DateTime?        @map("resolved_at") @db.Timestamp(6)
    createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)

    post     Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
    group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
    reporter User  @relation("PostReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
    resolver User? @relation("PostReportResolver", fields: [resolverId], references: [id], onDelete: SetNull)

    @@index([groupId, status, createdAt(sort: Desc)])
    @@index([postId])
    @@index([reporterId])
    @@map("post_reports")
}

// Synced with pgAdmin table: public.test_users
model TestUser {
    id        Int       @id @default(autoincrement())
    name      String    @db.VarChar(100)
    email     String    @unique @db.VarChar(100)
    createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

    @@map("test_users")
}
